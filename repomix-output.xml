      if (!user) {
        setLoading(false);
        return;
      }

      const { data, error } = await supabase
        .from("cars")
        .select("*")
        .eq("user_id", user.id)
        .order("id", { ascending: false });

      if (error) {
        console.error("ERRORE CARICAMENTO MEZZI:", error);
      }

      setCars(data || []);
    } catch (err) {
      console.error("Errore inatteso:", err);
    } finally {
      setLoading(false);
    }
  }

  useEffect(() => {
    loadCars();
