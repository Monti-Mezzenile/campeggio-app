                  className={`relative h-[135px] rounded-3xl p-4 overflow-hidden shadow-md border transition-all duration-200 active:scale-[0.98] flex flex-col justify-between ${
                    isFirst
                      ? "bg-[#1b2b25] border-[#ebdec8]/30 text-[#ebdec8]"
